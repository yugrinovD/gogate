# gogate local configuration template.
# Run `make init-env` to create a .env with fresh random secrets.
# Never commit the generated .env file.

GOGATE_ENV=dev
GOGATE_PUBLIC_ADDR=:8080
GOGATE_ADMIN_ADDR=:9090
GOGATE_ADMIN_TOKEN=replace-with-a-random-admin-token
GOGATE_API_KEY_PEPPER=replace-with-at-least-16-random-characters

GOGATE_DATABASE_URL=postgres://gogate:replace-with-a-random-postgres-password@postgres:5432/gogate?sslmode=disable
GOGATE_REDIS_ADDR=redis:6379
GOGATE_REDIS_PASSWORD=replace-with-a-random-redis-password
GOGATE_REDIS_DB=0

GOGATE_MAX_BODY_BYTES=1048576
GOGATE_MAX_OUTPUT_TOKENS=4096
GOGATE_MAX_MESSAGES=128
GOGATE_MAX_INFLIGHT=4096
GOGATE_MAX_API_KEY_BYTES=256
GOGATE_REQUEST_TIMEOUT=120s
GOGATE_FIRST_BYTE_TIMEOUT=30s
GOGATE_STREAM_IDLE_TIMEOUT=60s

GOGATE_CACHE_ENABLED=true
GOGATE_CACHE_TTL=5m
# 0 disables periodic control-plane reload; Redis pub/sub still works.
GOGATE_CONTROL_RELOAD_INTERVAL=30s
GOGATE_SEMANTIC_CACHE_ENABLED=false
GOGATE_EMBEDDING_PROVIDER=mock
GOGATE_EMBEDDING_MODEL=mock-embed
GOGATE_SEMANTIC_THRESHOLD=0.95

GOGATE_RATE_LIMIT_ENABLED=true
GOGATE_RATE_LIMIT_FAIL_OPEN=false
GOGATE_PII_REDACT=false
GOGATE_AUDIT_ENABLED=true
GOGATE_BUDGET_ENABLED=true
GOGATE_AUDIT_RETENTION=720h

GOGATE_BOOTSTRAP_PROVIDERS=true
GOGATE_MOCK_MODELS=mock,mock-fast
GOGATE_OLLAMA_BASE_URL=http://ollama:11434
GOGATE_OLLAMA_MODELS=qwen2.5:3b
# Pinned tag used by the standalone `ai` profile and by make pull-model.
# Keep it equal to the value in GOGATE_OLLAMA_MODELS.
OLLAMA_MODEL=qwen2.5:3b
GOGATE_OPENAI_BASE_URL=
GOGATE_UPSTREAM_KEY_PREFIX=GOGATE_UPSTREAM_
GOGATE_OPENAI_KEY_ENV=GOGATE_UPSTREAM_OPENAI_API_KEY
GOGATE_OPENAI_MODELS=
# Required for the local Compose Ollama service; code default is false.
GOGATE_ALLOW_PRIVATE_UPSTREAMS=true

GOGATE_METRICS_ENABLED=true
# Compose includes Jaeger; the built-in code default is false.
GOGATE_TRACING_ENABLED=true
GOGATE_TRACE_SAMPLE_RATIO=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
GOGATE_LOG_LEVEL=info
GOGATE_ACCESS_LOG_SAMPLE=1
GOGATE_PPROF_ENABLED=false
GOGATE_CORS_ALLOWED_ORIGINS=
GOGATE_READ_HEADER_TIMEOUT=5s
GOGATE_IDLE_TIMEOUT=120s
GOGATE_DATABASE_MAX_CONNS=20
GOGATE_REDIS_POOL_SIZE=64

# Docker Compose host ports
GOGATE_HTTP_PORT=8080
GOGATE_ADMIN_PORT=9090
GOGATE_PROM_PORT=9092
GOGATE_GRAFANA_PORT=3000
GOGATE_JAEGER_PORT=16686
GOGATE_OTLP_PORT=4318
# Bind to loopback only; do not expose Ollama publicly.
GOGATE_OLLAMA_PORT=11434
GOGATE_MOCK_PORT=8081
GOGATE_POSTGRES_PORT=5433
GOGATE_REDIS_PORT=6380

# Docker Compose infrastructure
POSTGRES_DB=gogate
POSTGRES_USER=gogate
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-random-grafana-password
